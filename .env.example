# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Required by almost every lesson.
# Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Required only by the embedding lessons (34, 36, 38).
# Create one at https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides. The defaults are deliberately cheap teaching models.
# See docs/MODELS.md.
# ---------------------------------------------------------------------------

# Default model for lessons.            default: claude-sonnet-5
# CLAUDE_MODEL=claude-opus-5

# Cheap model for bulk / mechanical work. default: claude-haiku-4-5
# CLAUDE_FAST_MODEL=claude-haiku-4-5

# Voyage embedding model (lessons 34-38). default: voyage-4-lite
# VOYAGE_MODEL=voyage-4

# Default max_tokens for short lessons.   default: 1024
# CLAUDE_MAX_TOKENS=1024
